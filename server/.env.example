# Copy to .env and adjust. Bun loads .env automatically.
PORT=8787
HOST=::
LOG_LEVEL=info

# Session token signing key (>= 32 chars). Generate one with: openssl rand -base64 48
JWT_SECRET=
TOKEN_TTL_SECONDS=900

# Local Postgres from infrastructure/docker/compose.yml (dev only; use a managed secret in production)
DATABASE_URL=postgres://lumio:lumio_dev@localhost:5442/lumio

# Used by `make test` for integration tests. Must point at a disposable database.
TEST_DATABASE_URL=postgres://lumio:lumio_dev@localhost:5442/lumio_test

# File sharing: where files in transit are kept, and the largest file a device may send (bytes).
FILES_DIR=./data/transfers
MAX_FILE_BYTES=1073741824
