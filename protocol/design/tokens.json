{
  "$description": "Synq design tokens shared by desktop (Tailwind theme) and mobile (Flutter ThemeData). Dark-first; layouts differ per platform, tokens do not.",
  "color": {
    "bg": "#07080c",
    "surface": "#0e1017",
    "surfaceRaised": "#151823",
    "glass": "#ffffff0d",
    "border": "#ffffff14",
    "borderStrong": "#ffffff26",
    "text": "#f4f5fb",
    "textMuted": "#9aa0b4",
    "textFaint": "#5d6378",
    "accent": "#7c5cff",
    "accentAlt": "#22d3ee",
    "online": "#34d399",
    "offline": "#5d6378",
    "warning": "#fbbf24",
    "danger": "#f87171"
  },
  "radius": { "sm": 8, "md": 14, "lg": 20, "xl": 28, "pill": 999 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "font": {
    "family": "Inter",
    "monoFamily": "JetBrains Mono",
    "size": { "caption": 12, "body": 14, "bodyLg": 16, "title": 20, "headline": 28, "display": 40 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "tracking": { "tight": -0.02, "normal": 0, "wide": 0.04 }
  },
  "motion": {
    "durationFast": 140,
    "durationBase": 220,
    "durationSlow": 420,
    "easing": [0.22, 1, 0.36, 1]
  }
}
