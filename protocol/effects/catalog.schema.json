{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.app/schemas/v1/catalog.schema.json",
  "title": "EffectCatalog",
  "description": "The trusted effect catalog shipped inside every client build. A receiver renders an effect only if its id is in this catalog AND the client has a renderer registered for it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "effects"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/EffectDefinition" }
    }
  },
  "$defs": {
    "EffectDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "category",
        "defaultDuration",
        "minDuration",
        "maxDuration",
        "defaultIntensity",
        "renderer",
        "supportedPlatforms",
        "hasSound",
        "accent"
      ],
      "properties": {
        "id": { "type": "string", "maxLength": 48, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "description": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "enum": ["space", "light", "nature", "energy", "party", "digital"] },
        "defaultDuration": { "type": "integer", "minimum": 1000, "maximum": 15000 },
        "minDuration": { "type": "integer", "minimum": 1000, "maximum": 15000 },
        "maxDuration": { "type": "integer", "minimum": 1000, "maximum": 15000 },
        "defaultIntensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["web", "flutter"],
          "properties": {
            "web": { "enum": ["canvas", "webgl", "lottie"] },
            "flutter": { "enum": ["painter", "shader", "lottie"] }
          }
        },
        "supportedPlatforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["macos", "windows", "linux", "android", "ios"] }
        },
        "hasSound": { "type": "boolean" },
        "accent": {
          "description": "Two hex colours used for previews and UI chips.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
        }
      }
    }
  }
}
